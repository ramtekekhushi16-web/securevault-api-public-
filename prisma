generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  email String @unique
  password String
  role String @default("USER")
  credentials Credential[]
  auditLogs AuditLog[]
}
model Credential {
  id String @id @default(uuid())
  title String
  username String
  passwordEncrypted String
  iv String
  authTag String
  website String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model AuditLog {
  id String @id @default(uuid())
  action String
  resource String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}