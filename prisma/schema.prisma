generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String
  role Role @default(USER)
  vaults VaultItem[]
}

model VaultItem {
  id String @id @default(uuid())
  title String
  encryptedData String
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}